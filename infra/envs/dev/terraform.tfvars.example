# Template for a full-stack dev plan. The committed terraform.tfvars in this
# directory is the real dev apply: eu-north-1, data lake plus Glue catalog
# and Athena. It does not enable the rest of this template. The bytes scanned
# cutoff below is the provider minimum and matches the committed dev file.
aws_region  = "us-east-1"
environment = "dev"
# Replace before any future apply. The lake bucket name is global.
name_prefix = "example-ecom"

vpc_cidr = "10.10.0.0/16"
private_subnets = {
  a = { az = "us-east-1a", cidr = "10.10.1.0/24" }
  b = { az = "us-east-1b", cidr = "10.10.2.0/24" }
}

db_instance_class        = "db.t4g.micro"
db_allocated_storage     = 20
db_engine_version        = "16.8"
db_multi_az              = false
db_backup_retention_days = 1
log_retention_days       = 7
bedrock_model_id         = "amazon.nova-micro-v1:0"

# Smallest per-query scan cap the Terraform AWS provider accepts (10 MiB).
athena_bytes_scanned_cutoff_per_query = 10485760

enable_networking    = true
enable_data_lake     = true
enable_analytics     = true
enable_relational    = true
enable_nosql         = true
enable_streaming     = true
enable_api           = true
enable_llm           = true
enable_observability = true
