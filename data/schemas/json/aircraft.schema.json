{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aircraft.schema.json",
  "title": "Aircraft",
  "description": "Synthetic tail. The tail number is not an FAA registration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tail_number", "aircraft_type", "airline_iata", "seats"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "tail_number": { "type": "string", "pattern": "^T-[A-Z0-9]{2}[0-9]{4}$" },
    "aircraft_type": { "type": "string", "pattern": "^[A-Z0-9]{3,4}$" },
    "airline_iata": { "type": "string", "pattern": "^[A-Z0-9]{2}$" },
    "seats": { "type": "integer", "minimum": 1 }
  }
}
