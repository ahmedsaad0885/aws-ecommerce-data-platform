{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aircraft_type.schema.json",
  "title": "AircraftType",
  "description": "Planning ballparks for the fuel model. Cruise speed and fuel flow are not flight-manual values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "icao",
    "name",
    "seats",
    "cruise_tas_kt",
    "burn_kg_per_hour",
    "taxi_fuel_kg",
    "reserve_minutes"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "icao": { "type": "string", "pattern": "^[A-Z0-9]{3,4}$" },
    "name": { "type": "string", "minLength": 1 },
    "seats": { "type": "integer", "minimum": 1 },
    "cruise_tas_kt": { "type": "integer", "minimum": 100, "maximum": 700 },
    "burn_kg_per_hour": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "taxi_fuel_kg": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "reserve_minutes": { "type": "integer", "minimum": 0, "maximum": 120 }
  }
}
