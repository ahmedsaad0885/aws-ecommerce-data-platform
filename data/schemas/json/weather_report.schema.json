{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weather_report.schema.json",
  "title": "WeatherReport",
  "description": "Hourly airport observation inspired by METAR. flight_category is derived from ceiling and visibility. This is not a copy of a live weather feed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "airport_iata",
    "airport_icao",
    "observed_at",
    "wind_dir_deg",
    "wind_speed_kt",
    "wind_gust_kt",
    "visibility_sm",
    "ceiling_ft",
    "precip",
    "temp_c",
    "dewpoint_c",
    "altimeter_inhg",
    "flight_category",
    "airport_closed"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "report_id": { "type": "string", "pattern": "^wx_[A-Z]{4}_[0-9]{10}$" },
    "airport_iata": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "airport_icao": { "type": "string", "pattern": "^[A-Z]{4}$" },
    "observed_at": { "type": "string", "minLength": 20 },
    "wind_dir_deg": { "type": "integer", "minimum": 0, "maximum": 359 },
    "wind_speed_kt": { "type": "integer", "minimum": 0, "maximum": 80 },
    "wind_gust_kt": { "type": ["integer", "null"], "minimum": 0, "maximum": 120 },
    "visibility_sm": { "type": "string", "pattern": "^[0-9]+\\.[0-9]$" },
    "ceiling_ft": { "type": ["integer", "null"], "minimum": 0, "maximum": 20000 },
    "precip": { "type": "string", "enum": ["none", "rain", "snow", "thunderstorm"] },
    "temp_c": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]$" },
    "dewpoint_c": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]$" },
    "altimeter_inhg": { "type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}$" },
    "flight_category": { "type": "string", "enum": ["VFR", "MVFR", "IFR", "LIFR"] },
    "airport_closed": { "type": "boolean" }
  }
}
