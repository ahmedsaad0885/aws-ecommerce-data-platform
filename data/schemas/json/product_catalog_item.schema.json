{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "product_catalog_item.schema.json",
  "title": "ProductCatalogItem",
  "description": "DynamoDB product catalog item. product_id is the partition key. category is the GSI partition key.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "sku",
    "name",
    "category",
    "status",
    "price",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "product_id": { "type": "string", "minLength": 1 },
    "sku": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["active", "discontinued"] },
    "price": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "updated_at": { "type": "string", "minLength": 20 }
  }
}
