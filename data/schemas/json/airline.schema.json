{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "airline.schema.json",
  "title": "Airline",
  "description": "Airline reference. IATA and ICAO codes are the public identifiers. hub_iata is the primary hub in this network.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "iata", "icao", "name", "hub_iata"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "iata": { "type": "string", "pattern": "^[A-Z0-9]{2}$" },
    "icao": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "name": { "type": "string", "minLength": 1 },
    "hub_iata": { "type": "string", "pattern": "^[A-Z]{3}$" }
  }
}
