{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fuel_record.schema.json",
  "title": "FuelRecord",
  "description": "Fuel plan or revision. Inputs (distance, wind, burn rate, taxi, alternate, reserve, contingency, burn already used, extra uplift) are stored beside the rounded results. Kilograms and nautical miles are decimal strings. See docs/airport-data-model.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "occurred_at",
    "flight_id",
    "tail_number",
    "aircraft_type",
    "stage",
    "origin_iata",
    "origin_icao",
    "destination_iata",
    "destination_icao",
    "previous_destination_iata",
    "alternate_iata",
    "alternate_icao",
    "distance_nm",
    "course_deg",
    "cruise_tas_kt",
    "wind_dir_deg",
    "wind_speed_kt",
    "wind_component_kt",
    "ground_speed_kt",
    "burn_kg_per_hour",
    "trip_minutes",
    "trip_fuel_kg",
    "taxi_fuel_kg",
    "contingency_rate",
    "contingency_fuel_kg",
    "alternate_distance_nm",
    "alternate_fuel_kg",
    "reserve_minutes",
    "reserve_fuel_kg",
    "burn_so_far_kg",
    "planned_fuel_kg",
    "extra_fuel_kg",
    "uplift_kg",
    "estimated_burn_kg",
    "remaining_fuel_kg",
    "decision_fraction",
    "weather_report_id",
    "reroute_event_id"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "event_id": { "type": "string", "pattern": "^fue_[0-9]{8}$" },
    "event_type": { "type": "string", "enum": ["FuelCalculated", "FuelRevised"] },
    "occurred_at": { "type": "string", "minLength": 20 },
    "flight_id": { "type": "string", "minLength": 8 },
    "tail_number": { "type": "string", "pattern": "^T-[A-Z0-9]{2}[0-9]{4}$" },
    "aircraft_type": { "type": "string", "pattern": "^[A-Z0-9]{3,4}$" },
    "stage": { "type": "string", "enum": ["preflight", "airborne"] },
    "origin_iata": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "origin_icao": { "type": "string", "pattern": "^[A-Z]{4}$" },
    "destination_iata": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "destination_icao": { "type": "string", "pattern": "^[A-Z]{4}$" },
    "previous_destination_iata": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
    "alternate_iata": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "alternate_icao": { "type": "string", "pattern": "^[A-Z]{4}$" },
    "distance_nm": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "course_deg": { "type": "integer", "minimum": 0, "maximum": 359 },
    "cruise_tas_kt": { "type": "integer", "minimum": 100, "maximum": 700 },
    "wind_dir_deg": { "type": "integer", "minimum": 0, "maximum": 359 },
    "wind_speed_kt": { "type": "integer", "minimum": 0, "maximum": 80 },
    "wind_component_kt": { "type": "integer", "minimum": -200, "maximum": 200 },
    "ground_speed_kt": { "type": "integer", "minimum": 200, "maximum": 800 },
    "burn_kg_per_hour": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "trip_minutes": { "type": "integer", "minimum": 1, "maximum": 2000 },
    "trip_fuel_kg": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "taxi_fuel_kg": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "contingency_rate": { "type": "string", "pattern": "^0\\.[0-9]{2}$" },
    "contingency_fuel_kg": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "alternate_distance_nm": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "alternate_fuel_kg": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "reserve_minutes": { "type": "integer", "minimum": 0, "maximum": 120 },
    "reserve_fuel_kg": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "burn_so_far_kg": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "planned_fuel_kg": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "extra_fuel_kg": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "uplift_kg": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "estimated_burn_kg": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "remaining_fuel_kg": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "decision_fraction": { "type": "string", "pattern": "^(?:0\\.[0-9]{2}|1\\.00)$" },
    "weather_report_id": { "type": "string", "pattern": "^wx_[A-Z]{4}_[0-9]{10}$" },
    "reroute_event_id": { "type": ["string", "null"], "pattern": "^fev_[0-9]{8}$" }
  }
}
