{
  "type": "record",
  "name": "FuelRecord",
  "namespace": "ecommerce.airports",
  "doc": "Stream twin of schemas/json/fuel_record.schema.json. Inputs and rounded results.",
  "fields": [
    { "name": "schema_version", "type": "int" },
    { "name": "event_id", "type": "string" },
    {
      "name": "event_type",
      "type": {
        "type": "enum",
        "name": "FuelEventType",
        "symbols": ["FuelCalculated", "FuelRevised"]
      }
    },
    { "name": "occurred_at", "type": "string" },
    { "name": "flight_id", "type": "string" },
    { "name": "tail_number", "type": "string" },
    { "name": "aircraft_type", "type": "string" },
    {
      "name": "stage",
      "type": { "type": "enum", "name": "FuelStage", "symbols": ["preflight", "airborne"] }
    },
    { "name": "origin_iata", "type": "string" },
    { "name": "origin_icao", "type": "string" },
    { "name": "destination_iata", "type": "string" },
    { "name": "destination_icao", "type": "string" },
    { "name": "previous_destination_iata", "type": ["null", "string"], "default": null },
    { "name": "alternate_iata", "type": "string" },
    { "name": "alternate_icao", "type": "string" },
    { "name": "distance_nm", "type": "string" },
    { "name": "course_deg", "type": "int" },
    { "name": "cruise_tas_kt", "type": "int" },
    { "name": "wind_dir_deg", "type": "int" },
    { "name": "wind_speed_kt", "type": "int" },
    { "name": "wind_component_kt", "type": "int", "doc": "Headwind positive, tailwind negative" },
    { "name": "ground_speed_kt", "type": "int" },
    { "name": "burn_kg_per_hour", "type": "string" },
    { "name": "trip_minutes", "type": "int" },
    { "name": "trip_fuel_kg", "type": "string" },
    { "name": "taxi_fuel_kg", "type": "string" },
    { "name": "contingency_rate", "type": "string" },
    { "name": "contingency_fuel_kg", "type": "string" },
    { "name": "alternate_distance_nm", "type": "string" },
    { "name": "alternate_fuel_kg", "type": "string" },
    { "name": "reserve_minutes", "type": "int" },
    { "name": "reserve_fuel_kg", "type": "string" },
    { "name": "burn_so_far_kg", "type": "string" },
    { "name": "planned_fuel_kg", "type": "string" },
    { "name": "extra_fuel_kg", "type": "string" },
    { "name": "uplift_kg", "type": "string" },
    { "name": "estimated_burn_kg", "type": "string" },
    { "name": "remaining_fuel_kg", "type": "string" },
    { "name": "decision_fraction", "type": "string" },
    { "name": "weather_report_id", "type": "string" },
    { "name": "reroute_event_id", "type": ["null", "string"], "default": null }
  ]
}
